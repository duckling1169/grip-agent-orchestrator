{
  "name": "moxy",
  "version": "0.0.0",
  "private": true,
  "description": "One persistent conversation that coordinates coding agents across repositories and providers, from any device on your tailnet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.7.0",
    "@agentclientprotocol/sdk": "2.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mcp-remote": "0.16.6",
    "semver": "^7.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "bin": {
    "moxy": "dist/cli.js"
  }
}
