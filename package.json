{
  "name": "grip-agent-orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "See and control orchestrated coding agents from any device on your tailnet, on top of Claw Orchestrator.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run web:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "smoke:supervisor": "tsx scripts/supervisor-smoke.ts",
    "dev": "tsx src/cli.ts",
    "web:dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "tsx scripts/web-preview.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "preact": "^11.2.0",
    "semver": "^7.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "bin": {
    "grip": "dist/src/cli.js"
  }
}
