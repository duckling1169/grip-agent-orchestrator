{
  "name": "moxy",
  "version": "0.0.0",
  "private": true,
  "description": "One persistent conversation that coordinates coding agents across repositories and providers, from any device on your tailnet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run web:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:web": "playwright test",
    "dev": "tsx src/cli.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "npm run web:build && tsx scripts/web-preview.ts",
    "check:workers": "tsx scripts/check-workers.ts"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.7.0",
    "@agentclientprotocol/sdk": "2.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "mcp-remote": "0.16.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.7.3",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "bin": {
    "moxy": "dist/cli.js"
  }
}
